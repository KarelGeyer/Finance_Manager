@using AppUI.State

@inject UserState UserState

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">Financial Overview</MudText>

    <!-- Summary Cards -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Total Assets</MudText>
                            <MudText Typo="Typo.h5">$@totalAssets.ToString("N0")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">+12% YTD</MudText>
                        </div>
                        <MudIcon Icon="Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Warning">Total Debts</MudText>
                            <MudText Typo="Typo.h5">$@totalDebts.ToString("N0")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Error">-5% this month</MudText>
                        </div>
                        <MudIcon Icon="Icons.Material.Filled.TrendingDown" Size="Size.Large" Color="Color.Error" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Info">Net Worth</MudText>
                            <MudText Typo="Typo.h5">$@netWorth.ToString("N0")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">+18% YTD</MudText>
                        </div>
                        <MudIcon Icon="Icons.Material.Filled.AccountBalance" Size="Size.Large" Color="Color.Info" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Monthly Savings</MudText>
                            <MudText Typo="Typo.h5">$@monthlySavings.ToString("N0")</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">Target: 20%</MudText>
                        </div>
                        <MudIcon Icon="Icons.Material.Filled.Savings" Size="Size.Large" Color="Color.Secondary" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Charts Row -->
    <MudGrid Class="mb-6">
        <!-- Net Worth Trend -->
        <MudItem xs="12" md="8">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Net Worth Trend</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart 
                        ChartType="ChartType.Line"
                        ChartSeries="@netWorthSeries"
                        XAxisLabels="@monthLabels"
                        Width="100%" 
                        Height="300px"
                        ChartOptions="@chartOptions" />
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Financial Distribution -->
        <MudItem xs="12" md="4">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Financial Distribution</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart 
                        ChartType="ChartType.Donut"
                        InputData="@distributionData"
                        InputLabels="@distributionLabels"
                        Width="100%"
                        Height="250px" />
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Financial Goals -->
    <MudCard Class="pa-4" Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Financial Goals Progress</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <div class="mb-4">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body1">Emergency Fund</MudText>
                            <MudText Typo="Typo.body2">$15,000 / $20,000</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Success" Size="Size.Medium" Value="75" />
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body1">Retirement Savings</MudText>
                            <MudText Typo="Typo.body2">$85,000 / $150,000</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Size="Size.Medium" Value="57" />
                    </div>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="mb-4">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body1">House Down Payment</MudText>
                            <MudText Typo="Typo.body2">$45,000 / $60,000</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Warning" Size="Size.Medium" Value="75" />
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body1">Investment Portfolio</MudText>
                            <MudText Typo="Typo.body2">$125,000 / $200,000</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Info" Size="Size.Medium" Value="62" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // Mock data - replace with actual service calls
    private decimal totalAssets = 580000;
    private decimal totalDebts = 185000;
    private decimal netWorth = 395000;
    private decimal monthlySavings = 2400;

    // Chart data
    private List<ChartSeries> netWorthSeries = new();
    private string[] monthLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    private ChartOptions chartOptions = new();
    
    private double[] distributionData = { 60, 25, 15 };
    private string[] distributionLabels = { "Assets", "Savings", "Investments" };

    protected override void OnInitialized()
    {
        InitializeChartData();
    }

    private void InitializeChartData()
    {
        netWorthSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = "Net Worth",
                Data = new double[] { 320000, 335000, 342000, 358000, 365000, 372000, 380000, 385000, 388000, 390000, 393000, 395000 }
            }
        };

        chartOptions = new ChartOptions
        {
            YAxisTicks = 10000,
            LineStrokeWidth = 3
        };
    }
}
